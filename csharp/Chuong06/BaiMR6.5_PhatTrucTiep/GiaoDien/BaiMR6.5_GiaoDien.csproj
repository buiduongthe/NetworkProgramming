<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ứng dụng giao diện WinForms của MR6.5 (chỉ Windows). Dùng lại toàn bộ lõi của bản dòng lệnh ở thư mục cha
       (mọi tệp .cs trừ Program.cs): Chung.cs, MayChu.cs, MayPhat.cs, NguoiXem.cs, Camera.cs, TepVideo.cs,
       ThietBiAmThanh.cs. OutputType Exe (không phải WinExe) để kịch bản demo in được nhật ký ra stdout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BaiMR6_5</RootNamespace>
    <AssemblyName>BaiMR6.5_GiaoDien</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" Exclude="..\Program.cs" LinkBase="DungChung" />
  </ItemGroup>
</Project>
