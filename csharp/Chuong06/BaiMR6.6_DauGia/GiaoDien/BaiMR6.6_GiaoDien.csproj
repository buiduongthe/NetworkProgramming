<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ứng dụng giao diện WinForms của MR6.6 (chỉ Windows). Dùng lại toàn bộ lõi của bản dòng lệnh ở thư mục cha
       (mọi tệp .cs trừ Program.cs): Chung.cs, Khach.cs, MoPhong.cs, MayChu.cs, Server.cs, DauGia.cs.
       OutputType Exe (không phải WinExe) để kịch bản demo in được nhật ký ra stdout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BaiMR6_6</RootNamespace>
    <AssemblyName>BaiMR6.6_GiaoDien</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" Exclude="..\Program.cs" LinkBase="DungChung" />
  </ItemGroup>
</Project>
