<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bản dòng lệnh (chạy được trên Windows, Linux, macOS). Ứng dụng WinForms ở dự án riêng GiaoDien/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BaiMR5_6</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- thư mục GiaoDien/ là dự án net10.0-windows riêng: không biên dịch vào bản dòng lệnh -->
    <Compile Remove="GiaoDien/**" />
    <None Remove="GiaoDien/**" />
  </ItemGroup>
</Project>
