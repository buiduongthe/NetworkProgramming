      ],
      "background": true,
      "wait": 1.5
    },
    {
      "name": "client",
      "cmd": [
        "dotnet",
        "run",
        "--no-build",
        "-c",
        "Release",
        "--",
        "client",
        "127.0.0.1",
        "9742",
        "/events"
      ]
    }
  ],
  "titles": {
    "server": "Cửa sổ 1 – server SSE",
    "client": "Cửa sổ 2 – bộ đọc luồng SSE"
  }
