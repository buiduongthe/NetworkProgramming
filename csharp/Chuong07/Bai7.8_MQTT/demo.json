{
  "setup": [
    [
      "dotnet",
      "build",
      "-c",
      "Release",
      "-v",
      "q",
      "-nologo"
    ]
  ],
  "processes": [
    {
      "name": "broker",
      "cmd": [
        "mosquitto",
        "-p",
        "9782"
      ], "cmd_windows": ["mosquitto", "-c", "out/mosquitto_windows.conf"], "show_windows": "mosquitto -c out\\mosquitto_windows.conf   (cấu hình: cổng 9782, ghi nhật ký ra màn hình)",
      "background": true,
      "wait": 1.5
    },
    {
      "name": "dashboard",
      "cmd": [
        "dotnet",
        "run",
        "--no-build",
        "-c",
        "Release",
        "--",
        "dashboard",
        "localhost",
        "9782",
        "4"
      ],
      "background": true,
      "wait": 1.5
    },
    {
      "name": "day1",
      "cmd": [
        "dotnet",
        "run",
        "--no-build",
        "-c",
        "Release",
        "--",
        "sensor",
        "day1",
        "localhost",
        "9782",
        "3",
        "1000"
      ]
    },
    {
      "name": "day2",
      "cmd": [
        "dotnet",
        "run",
        "--no-build",
        "-c",
        "Release",
        "--",
        "sensor",
        "day2",
        "localhost",
        "9782",
        "2",
        "1000",
        "--mat-ket-noi"
      ],
      "wait": 3.0
    },
    {
      "name": "dashboard2",
      "cmd": [
        "timeout",
        "-s",
        "INT",
        "3",
        "dotnet",
        "run",
        "--no-build",
        "-c",
        "Release",
        "--",
        "dashboard",
        "localhost",
        "9782",
        "60",
        "dashboard-02"
      ]
    }
  ],
  "titles": {
    "broker": "Cửa sổ 1 – broker mosquitto",
    "dashboard": "Cửa sổ 2 – bảng theo dõi (chạy từ đầu)",
    "day1": "Cửa sổ 3 – cảm biến day1",
    "day2": "Cửa sổ 4 – cảm biến day2 (mất kết nối)",
    "dashboard2": "Cửa sổ 5 – bảng thứ hai, đăng ký muộn"
  },
  "setup_windows": [["dotnet", "build", "-c", "Release", "-v", "q", "-nologo"], ["@ghi_tep", "out/mosquitto_windows.conf", "listener 9782 127.0.0.1\\nlistener 9782 ::1\\nallow_anonymous true\\nlog_dest stdout\\nlog_type error\\nlog_type warning\\nlog_type notice\\nlog_type information\\n"]]
}
