{
  "setup": [
    [
      "javac",
      "-encoding",
      "UTF-8",
      "-d",
      "out",
      "Reader.java",
      "Json.java",
      "RestServer.java",
      "RestClient.java"
    ]
  ],
  "processes": [
    {
      "name": "server",
      "cmd": [
        "java",
        "-cp",
        "out",
        "RestServer",
        "127.0.0.1",
        "9723"
      ],
      "background": true,
      "wait": 0.8
    },
    {
      "name": "client",
      "cmd": [
        "java",
        "-cp",
        "out",
        "RestClient",
        "127.0.0.1",
        "9723"
      ],
      "stdin": "GET /api/v1/terms\nGET /api/v1/terms/TCP\nGET /api/v1/terms/Keep%20alive\nGET /api/v1/terms/XYZ\nPOST /api/v1/terms {\"term\":\"QUIC\",\"text\":\"Giao thức vận chuyển trên UDP\"}\nGET /api/v1/terms/QUIC\nDELETE /api/v1/terms/QUIC\nPUT /api/v1/terms/TCP {\"text\":\"x\"}\nGET /api/v2/khac\n"
    },
    {
      "name": "curl",
      "cmd": [
        "sh",
        "curl_demo.sh",
        "9723"
      ], "cmd_windows": [["@echo", "> curl -i http://127.0.0.1:9723/api/v1/terms/UDP"], ["curl", "-s", "-i", "http://127.0.0.1:9723/api/v1/terms/UDP"], ["@echo", ""], ["@echo", ""], ["@echo", "> curl -i -H \"Transfer-Encoding: chunked\" -d \"{\\\"term\\\":\\\"A\\\",\\\"text\\\":\\\"B\\\"}\" http://127.0.0.1:9723/api/v1/terms"], ["curl", "-s", "-i", "-H", "Transfer-Encoding: chunked", "-d", "{\"term\":\"A\",\"text\":\"B\"}", "http://127.0.0.1:9723/api/v1/terms"], ["@echo", ""], ["@echo", ""], ["@echo", "> curl -i -X POST -H \"Content-Length: 4000000000\" http://127.0.0.1:9723/api/v1/terms"], ["curl", "-s", "-i", "-X", "POST", "-H", "Content-Length: 4000000000", "http://127.0.0.1:9723/api/v1/terms"], ["@echo", ""]], "show_windows": "rem ba yêu cầu curl.exe (in từng lệnh bên dưới)"
    }
  ],
  "titles": {
    "server": "Cửa sổ 1 – server REST",
    "client": "Cửa sổ 2 – client (keep-alive)",
    "curl": "Cửa sổ 3 – curl"
