{
  "env": {"LANGUAGE": "vi"},
  "setup": [["go", "build", "-o", "out/app", "."],
            ["go", "-C", "gui", "mod", "tidy"],
            ["go", "-C", "gui", "build", "-o", "../out/app_gui", "."]],
  "processes": [
    {"name": "server", "cmd": ["out/app", "server", "127.0.0.1", "41705"], "background": true, "wait": 0.8},
    {"name": "mp", "cmd": ["out/app", "mo_phong", "127.0.0.1", "41705", "--n", "500", "--so-sanh"], "timeout": 120, "wait": 0.3},
    {"name": "qt", "cmd": ["out/app", "khach", "127.0.0.1", "41705", "dat_lai", "thoi_gian_s=5", "gia_han_s=3"], "timeout": 10, "wait": 0.1},
    {"name": "A", "cmd": ["out/app", "dau_gia", "An", "127.0.0.1", "41705", "--thoi-gian", "11"], "stdin": "@1 tang 1\n@6.6 tang 1\n", "background": true, "wait": 0.3},
    {"name": "B", "cmd": ["out/app", "dau_gia", "Bình", "127.0.0.1", "41705", "--thoi-gian", "10.4"], "stdin": "@0.5 tang 2\n@3.6 tang 1\n@10 tang 1\n", "timeout": 20, "wait": 1.0},
    {"name": "gui", "cmd": ["xvfb-run", "-a", "-s", "-screen 0 2600x1700x24", "out/app_gui", "demo_gui", "127.0.0.1", "41707"], "show": ["xvfb-run", "-a", "out/app_gui", "demo_gui", "127.0.0.1", "41707"], "timeout": 150}
  ],
  "titles": {"server": "Cửa sổ 1 – máy chủ đấu giá (đa luồng, chế độ khoa)",
             "mp": "Cửa sổ 2 – mô phỏng 500 người × 5 lần, so sánh 4 chế độ",
             "qt": "Cửa sổ 3 – quản trị (mở phiên 5 s, gia hạn 3 s)",
             "A": "Cửa sổ 4 – người trả giá An",
             "B": "Cửa sổ 5 – người trả giá Bình (trả giá phút cuối)",
             "gui": "Cửa sổ 6 – ứng dụng giao diện Fyne (máy chủ + 3 phòng đấu giá)"}
}
