{
  "env": {"LANGUAGE": "vi"},
  "setup": [["go", "build", "-o", "out/app", "."],
            ["go", "-C", "gui", "mod", "tidy"],
            ["go", "-C", "gui", "build", "-o", "../out/app_gui", "."]],
  "processes": [
    {"name": "server", "cmd": ["out/app", "server", "127.0.0.1", "41745"], "background": true, "wait": 0.8},
    {"name": "mp", "cmd": ["out/app", "mo_phong", "127.0.0.1", "41745", "--n", "2000", "--so-sanh"], "timeout": 120, "wait": 0.3},
    {"name": "qt", "cmd": ["out/app", "khach", "127.0.0.1", "41745", "dat_lai", "si_so=2"], "timeout": 10, "wait": 0.1},
    {"name": "A", "cmd": ["out/app", "dang_ky", "An", "127.0.0.1", "41745", "--thoi-gian", "6.5"], "stdin": "@0.5 dk 123013-01\n@3 huy 123013-01\n", "background": true, "wait": 0.3},
    {"name": "B", "cmd": ["out/app", "dang_ky", "Bình", "127.0.0.1", "41745"], "stdin": "@0.5 dk 123013-01 x2\n", "timeout": 10, "wait": 0.3},
    {"name": "C", "cmd": ["out/app", "dang_ky", "Chi", "127.0.0.1", "41745"], "stdin": "dk 123013-01\n@2.5 dk 123013-01\n@3 xem\n", "timeout": 10, "wait": 2.0},
    {"name": "gui", "cmd": ["xvfb-run", "-a", "-s", "-screen 0 2600x1700x24", "out/app_gui", "demo_gui", "127.0.0.1", "41747"], "show": ["xvfb-run", "-a", "out/app_gui", "demo_gui", "127.0.0.1", "41747"], "timeout": 150}
  ],
  "titles": {"server": "Cửa sổ 1 – máy chủ đăng ký học phần (đa luồng, chế độ khoa)",
             "mp": "Cửa sổ 2 – mô phỏng 2000 sinh viên, 3 lớp × 50, so sánh 4 chế độ",
             "qt": "Cửa sổ 3 – quản trị (đợt mới, sĩ số 2)",
             "A": "Cửa sổ 4 – sinh viên An (đăng ký rồi hủy)",
             "B": "Cửa sổ 5 – sinh viên Bình (bấm đúp)",
             "C": "Cửa sổ 6 – sinh viên Chi (lớp đủ, chờ chỗ trống)",
             "gui": "Cửa sổ 7 – ứng dụng giao diện (máy chủ + 3 cổng đăng ký)"}
}
