{
  "setup": [["go", "build", "-o", "out/app", "."], ["sh", "tao_chung_chi.sh"]],
  "env": {"SMTP_USER": "sinhvien", "SMTP_PASS": "matkhau-thu"},
  "processes": [
    {"name": "server", "cmd": ["out/app", "server", "127.0.0.1", "31760"], "background": true, "wait": 1.0},
    {"name": "client", "cmd": ["out/app", "client", "localhost", "31760", "cert.pem"]},
    {"name": "client_sai", "cmd": ["sh", "-c", "SMTP_PASS=sai-mat-khau exec out/app client localhost 31760 cert.pem"], "cmd_windows": ["env", "SMTP_PASS=sai-mat-khau", "out/app", "client", "localhost", "31760", "cert.pem"],
     "show": ["SMTP_PASS=sai-mat-khau", "out/app", "client", "localhost", "31760", "cert.pem"]},
    {"name": "khong_tin_cay", "cmd": ["out/app", "client", "localhost", "31760", "-"]}
  ],
  "titles": {"server": "Cửa sổ 1 – server SMTP thử (Go)", "client": "Cửa sổ 2 – client SMTP",
             "client_sai": "Cửa sổ 3 – client, sai mật khẩu", "khong_tin_cay": "Cửa sổ 4 – client, kho tin cậy của hệ điều hành"},
  "setup_windows": [["go", "build", "-o", "out/app", "."], ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "30", "-keyout", "key.pem", "-out", "cert.pem", "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost,IP:127.0.0.1"]]
}
